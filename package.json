{
  "name": "courier",
  "productName": "Courier",
  "version": "1.0.0",
  "description": "A Dota 2 overlay that reads the draft, times the match and shows the pro builds. Official GSI + OpenDota.",
  "main": "electron-main.js",
  "author": "IsThisDemi",
  "homepage": "https://github.com/IsThisDemi/Courier",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "electron": "electron .",
    "sim": "node tools/gsi-sim.js",
    "test": "node tests/unit.js && node tests/e2e.js",
    "test:unit": "node tests/unit.js",
    "test:e2e": "node tests/e2e.js",
    "test:detect": "node tests/detect-test.js",
    "shots": "node tests/shots.js",
    "install-gsi": "node scripts/install-gsi.js",
    "uninstall-gsi": "node scripts/install-gsi.js --remove",
    "icons": "python3 tools/make-icons.py",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --arm64"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.65.1"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "io.github.isthisdemi.courier",
    "productName": "Courier",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "server.js",
      "lib/**",
      "renderer/**",
      "scripts/dota-path.js",
      "assets/**",
      "package.json"
    ],
    "artifactName": "Courier-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Courier-${version}-windows-setup.${ext}"
    },
    "portable": {
      "artifactName": "Courier-${version}-windows-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.games",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "Courier-${version}-mac-${arch}.${ext}"
    }
  }
}
